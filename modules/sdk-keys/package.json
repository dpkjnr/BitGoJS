{
  "name": "@bitgo/sdk-keys",
  "version": "1.0.0",
  "description": "Network-free key management, encryption and MPC/TSS primitives for BitGoJS",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "test": "yarn unit-test",
    "unit-test": "mocha --recursive test",
    "build": "yarn tsc --build --incremental --verbose .",
    "fmt": "prettier --write .",
    "check-fmt": "prettier --check '**/*.{ts,js,json}'",
    "clean": "rm -r ./dist",
    "lint": "eslint --quiet . && node scripts/check-no-network.js",
    "check-no-network": "node scripts/check-no-network.js",
    "prepare": "npm run build"
  },
  "author": "BitGo SDK Team <sdkteam@bitgo.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BitGo/BitGoJS.git",
    "directory": "modules/sdk-keys"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "yarn prettier --write",
      "yarn eslint --fix"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@bitgo/argon2": "^1.1.1",
    "@bitgo/sdk-lib-mpc": "^11.1.0",
    "@bitgo/secp256k1": "^1.11.1",
    "@bitgo/sjcl": "^1.1.0",
    "@noble/curves": "1.8.1",
    "bigint-crypto-utils": "3.1.4",
    "fp-ts": "^2.12.2",
    "io-ts": "npm:@bitgo-forks/io-ts@2.1.4",
    "paillier-bigint": "3.3.0",
    "secp256k1": "5.0.1"
  },
  "devDependencies": {
    "@bitgo/sdk-opensslbytes": "^2.1.0",
    "@types/mocha": "^9.1.0",
    "@types/node": "^24.10.9",
    "mocha": "10.6.0",
    "should": "^13.1.3",
    "tsx": "^4.20.4"
  },
  "files": [
    "dist"
  ]
}
