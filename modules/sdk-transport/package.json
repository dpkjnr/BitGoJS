{
  "name": "@bitgo/sdk-transport",
  "version": "1.0.0",
  "description": "HTTP transport interface for BitGoJS wallet code, with no client dependencies",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "test": "yarn unit-test",
    "unit-test": "mocha --recursive test",
    "build": "yarn tsc --build --incremental --verbose .",
    "fmt": "prettier --write .",
    "check-fmt": "prettier --check '**/*.{ts,js,json}'",
    "clean": "rm -r ./dist",
    "lint": "eslint --quiet .",
    "prepare": "npm run build"
  },
  "author": "BitGo SDK Team <sdkteam@bitgo.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BitGo/BitGoJS.git",
    "directory": "modules/sdk-transport"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "yarn prettier --write",
      "yarn eslint --fix"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/mocha": "^9.1.0",
    "@types/node": "^24.10.9",
    "mocha": "10.6.0",
    "should": "^13.1.3",
    "tsx": "^4.20.4"
  },
  "files": [
    "dist"
  ]
}
